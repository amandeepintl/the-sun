# Secrets - never commit real credentials
.env
.env.*
!.env.example

# Private keys and certificates - defence in depth against accidental commits
*.key
*.pem
*.p12
*.pfx

# Local databases (never contain production data, but never belong in git)
*.db
*.sqlite
*.sqlite3

# Virtual environments
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
*.so

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local runtime artifacts
*.log
logs/

# Agent/editor workspace metadata
.freebuff/

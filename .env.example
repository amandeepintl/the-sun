# The Sun - environment configuration
#
# Copy this file to `.env` and fill in real values. `.env` is gitignored and must
# never be committed. Every value below is placeholder text: no real secret,
# Discord ID, server ID, model name or credential belongs in this repository.
#
# Required for Stage A verification (postgres, redis, provider catalogue, Discord identity).

# ---------------------------------------------------------------------------
# Discord
# ---------------------------------------------------------------------------
# Bot token from the Discord Developer Portal -> your application -> Bot.
DISCORD_TOKEN=REPLACE_WITH_DISCORD_BOT_TOKEN

# ---------------------------------------------------------------------------
# PostgreSQL (async SQLAlchemy)
# ---------------------------------------------------------------------------
# Either scheme is accepted; `postgresql://...` is normalised to asyncpg internally.
# TLS requirements belong in the query string, e.g. ?ssl=require
DATABASE_URL=postgresql+asyncpg://REPLACE_WITH_USER:REPLACE_WITH_PASSWORD@REPLACE_WITH_HOST:5432/REPLACE_WITH_DATABASE

# Optional: a separate database for integration tests so your development data is
# never touched. When unset, integration tests use DATABASE_URL and roll back.
TEST_DATABASE_URL=

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
# Accepts redis:// or rediss:// (TLS). Managed providers usually need the TLS scheme.
REDIS_URL=rediss://REPLACE_WITH_USER:REPLACE_WITH_PASSWORD@REPLACE_WITH_HOST:6379/0

# ---------------------------------------------------------------------------
# AI providers
# ---------------------------------------------------------------------------
# A JSON object mapping a provider name to its configuration. `type` selects the
# adapter implementation. `api_key` may be given inline, but preferring
# `api_key_env` keeps the secret in its own environment variable.
#
# AI_PROVIDERS={"myprovider":{"type":"openai_compatible","base_url":"https://REPLACE_WITH_HOST/v1","api_key_env":"MYPROVIDER_API_KEY","default_model":"REPLACE_WITH_MODEL_ID","timeout_seconds":60}}
AI_PROVIDERS=

# The provider name (a key of AI_PROVIDERS) used when a guild has not chosen one.
DEFAULT_PROVIDER=

# Ordered providers to try, comma separated, when the chosen one fails.
# AI_FALLBACK_PROVIDERS=myotherprovider

# One environment variable per provider that used `api_key_env`.
# MYPROVIDER_API_KEY=REPLACE_WITH_PROVIDER_API_KEY

# ---------------------------------------------------------------------------
# AI request limits
# ---------------------------------------------------------------------------
# Total token budget for a single assembled context window.
AI_MAX_CONTEXT_TOKENS=8192
# Per-request HTTP timeout in seconds. Used for every provider that does not set
# its own `timeout_seconds`; a provider value wins over this one.
AI_REQUEST_TIMEOUT_SECONDS=60

# Retry and circuit breaking for provider calls.
# Attempts include the first try; only retryable failures are repeated.
AI_MAX_RETRIES=3
AI_RETRY_BASE_SECONDS=0.5
AI_RETRY_MAX_SECONDS=8.0
# After this many consecutive failures a provider is skipped until the window passes.
AI_CIRCUIT_FAILURE_THRESHOLD=5
AI_CIRCUIT_RESET_SECONDS=60

# ---------------------------------------------------------------------------
# Discord runtime
# ---------------------------------------------------------------------------
# Set a guild id to sync commands to that guild instantly while developing.
# Leave empty to publish commands globally.
DEV_GUILD_ID=
# Enable this only if you also enabled the Message Content intent in the portal.
# Slash commands and the message context action work either way; /summarize needs
# it to read other members' message text.
DISCORD_MESSAGE_CONTENT_INTENT=true

# ---------------------------------------------------------------------------
# Database pool
# ---------------------------------------------------------------------------
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800
DB_ECHO=false

# ---------------------------------------------------------------------------
# Cache
# ---------------------------------------------------------------------------
# Namespace prefix for every Redis key. Use a distinct value per environment.
REDIS_KEY_PREFIX=thesun
REDIS_MAX_CONNECTIONS=50

# ---------------------------------------------------------------------------
# Commands, limits and privacy
# ---------------------------------------------------------------------------
# Number of previous turns sent back with each question, in direct messages.
DEFAULT_HISTORY_LENGTH=20
# Turns shown per page by /history.
HISTORY_PAGE_SIZE=10
# Upper bound for /summarize, and how much of each message is quoted to the model.
SUMMARY_MAX_MESSAGES=100
SUMMARY_MAX_CHARS_PER_MESSAGE=1200

# Rate limiting. A server can override both values with /settings ratelimit.
RATE_LIMIT_ENABLED=true
DEFAULT_RATE_LIMIT_PER_USER_PER_MINUTE=6
DEFAULT_RATE_LIMIT_PER_GUILD_PER_MINUTE=30

# Caps for the memory a member saves explicitly with /memory.
MEMORY_MAX_ENTRIES=100
MEMORY_MAX_VALUE_CHARS=1000

# Retention. Leave DEFAULT_HISTORY_RETENTION_DAYS empty to keep stored turns until
# someone deletes them (/privacy forget or /settings retention); set a number of
# days to purge automatically. USAGE_RETENTION_DAYS=0 keeps usage records forever.
DEFAULT_HISTORY_RETENTION_DAYS=
USAGE_RETENTION_DAYS=90
# How often the purge runs. 0 disables the background task.
RETENTION_INTERVAL_HOURS=24

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true
APP_ENV=development

# Optional HTTP endpoint exposing /healthz, /readyz and /metrics.
METRICS_ENABLED=false
HEALTH_HOST=127.0.0.1
HEALTH_PORT=8080

# ---------------------------------------------------------------------------
# Docker Compose only
# ---------------------------------------------------------------------------
# Credentials for the bundled PostgreSQL service. Change the password if the
# compose stack is reachable from anywhere but your own machine.
POSTGRES_USER=thesun
POSTGRES_PASSWORD=thesun
POSTGRES_DB=thesun
POSTGRES_PORT=5432
REDIS_PORT=6379

# Set these to point the container at a managed database or hosted Redis instead of
# the bundled services, for example:
# CONTAINER_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME?ssl=require
# CONTAINER_REDIS_URL=rediss://USER:PASSWORD@HOST:6379/0

# Apply migrations at container start, and validate configuration first.
RUN_MIGRATIONS=true
CHECK_CONFIG_ON_START=true
